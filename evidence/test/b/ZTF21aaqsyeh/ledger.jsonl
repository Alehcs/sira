led": {}, "made_at": 59318.9392, "model": "v1", "n_points": 6, "object": "ZTF21aaqsyeh", "question": {"band": "ztfr", "direction": "above", "mjd": 59321.9392, "p_yes": 0.098, "reference": 219.87, "text": "Brighter in r three days from now than at its last r detection?"}, "remembered": false, "risky": null, "seen": [[59268.50248, "ztfg", "limit", 40.27, null], [59270.4836, "ztfr", "limit", 101.56, null], [59272.48186, "ztfr", "limit", 102.98, null], [59274.4813, "ztfg", "limit", 153.19, null], [59275.48374, "ztfg", "limit", 138.84, null], [59282.5234, "ztfg", "limit", 32.81, null], [59292.44256, "ztfg", "limit", 39.69, null], [59298.39824, "ztfr", "det", 150.83, 27.69], [59302.43988, "ztfr", "det", 165.86, 16.36], [59308.46054, "ztfg", "det", 104.07, 9.33], [59310.43953, "ztfr", "det", 227.21, 12.68], [59313.43919, "ztfr", "det", 219.87, 15.02], [59315.43947, "ztfr", "limit", 1011.77, null], [59317.46177, "ztfg", "det", 77.44, 12.38]], "skeptics": {"instrument": {"artifact": false, "confidence": 0.9, "why": "Multi-night g- and r-band detections over ~19 days with smooth ~0.1-0.3 mag evolution and a central PSF-like source rated real (p=0.82) are inconsistent with detector artifact."}, "memory": {"confidence": 1, "name": null, "recognised": false}, "physics": {"implausible": [{"hypothesis": "ibc", "why": "Peak 31 days ago puts all detections 10 to 30 days post-peak yet r band is flat to rising over 19 days instead of the rapid post-peak decline of a stripped-envelope supernova"}, {"hypothesis": "tde", "why": "Fitted temperature of 10000 K with observed red color near g minus r of 1 mag is far too cool and red for a tidal disruption event which must stay hot and blue near 20000 to 40000 K"}]}}, "team": {"calls": 9, "cost_usd": 0.1051}, "theories": [{"argument": "Long-lived r-band detection brightening to 18.0 mag near day -8.5 with g-band peak near 18.9 mag and decline to 19.2 mag by day -1.5 matches a redshift 0.12 broad Ia peaking at day -9.7 with chi2 per point 1.93 and leading weight 0.57 over rivals. The transient is a real PSF-like difference source with p 0.82 and deep pre-explosion limits to 20.1 mag consistent with an extragalactic explosion.", "hypothesis": "ia", "refuted_if": {"band": "ztfg", "day": 3, "direction": "above", "flux": 70, "why": "A broad Ia 13 days past peak must keep fading in g well below its day -1.5 level so persistent brightness would demand a plateau or continued power incompatible with Ia decline."}, "weakest_point": "Its weakest point is the very red color parameter 0.43 with flat early r-band evolution that forces an extreme broad and heavily reddened Ia at the edge of the normal population."}, {"argument": "The deep g non-detections to ~20 mag at -36 to -26 d followed by r rise to ~18.0 mag by -8.5 d with red g-r ~0.9 mag matches a stripped-envelope rise at z ~0.089 with excellent fit chi2 per point 0.75 and peak at -30.9 d. The real central PSF stamp with p_real 0.82 and subsequent g fading from 18.86 to 19.18 mag while r plateaus near 18.0 mag tracks post-maximum cooling and loss of blue flux expec", "hypothesis": "ibc", "refuted_if": {"band": "ztfg", "day": 3, "direction": "above", "flux": 95, "why": "A month post-peak stripped envelope must stay blue-faint on the cobalt tail, so renewed g brightness would rule out continued cooling."}, "weakest_point": "The fitted peak at -30.9 d precedes the observed r-band brightening from 18.45 mag at -20.5 d to 18.01 mag at -8.5 d, requiring a late or second maximum not in the simple template."}, {"argument": "The r-band holds near 18.0-18.4 mag from day -20 to -5 while g-band fades from 18.86 to 19.18 mag, giving a reddening g-r ~0.9 to 1.1 mag consistent with a cooling hydrogen envelope on plateau. The difference stamp is real with p=0.82 and the Type II fit places peak at -26.7 d at z=0.0933, putting the present epoch ~25 d post-peak well within a typical ~100 d Type II-P plateau.", "hypothesis": "ii", "refuted_if": {"band": "ztfr", "day": 5, "direction": "below", "flux": 110, "why": "A Type II-P must remain on its luminous plateau about 30 days after peak and cannot fade by ~0.8 mag in r in ten days."}, "weakest_point": "The fit is poor with chi2 per point 4.88 and negligible weight 0.0017, driven by the deep g limit at -26.5 d to 19.9 mag coinciding with the modeled bright peak at -26.7 d."}], "weights": {"ia": 0.7389, "ibc": 0.1289, "ii": 0.0022, "null": 0.1301}, "wording": {"term": "very unlikely", "text": "It is very unlikely that this object will look brighter three days from now than it did at its last brightness measurement.", "words_match": true}}, "prev": "1e711a9cf87b15e62902c7e32219da49a98a38b04fa2596adbc15bf52699df3f", "seq": 23, "time": "2021-04-14T22:32:26+00:00", "v": 2}
