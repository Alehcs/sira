# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Meta Model API (Muse Spark / Wonder)
MODEL_API_KEY=

# Baseten (Muse Spark Open, hackathon key)
BASETEN_API_KEY=

# Spend caps in USD, checked in code before every call
SIRA_CAP_META_TOTAL=150
SIRA_CAP_BASETEN_TOTAL=100
# Optional daily caps: SIRA_CAP_META_DAILY, SIRA_CAP_BASETEN_DAILY, SIRA_CAP_WONDER_DAILY

# Where the local cost log lives
SIRA_COST_LOG=var/costs.jsonl
