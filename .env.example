# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Meta Model API (Muse Spark / Wonder)
MODEL_API_KEY=

# Baseten (Muse Spark Open, hackathon key)
BASETEN_API_KEY=

# Spend caps in USD (hard stops enforced in code before every call)
SIRA_CAP_META_TOTAL=140
SIRA_CAP_META_DAILY=15
SIRA_CAP_BASETEN_TOTAL=90
SIRA_CAP_BASETEN_DAILY=15

# Where the local cost log lives
SIRA_COST_LOG=var/costs.jsonl
